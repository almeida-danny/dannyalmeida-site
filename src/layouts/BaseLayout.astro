---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} — Danny Almeida</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600&family=Work+Sans:wght@400;500&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="name">Danny Almeida</a>
            
            <nav>
                <a href="/">Home</a>
                <a href="/perspective">Perspective</a>
                <a href="/work">Work</a>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
            </nav>
        </header>

        <slot />

        <footer>
            <a href="https://linkedin.com/in/danielfrancisalmeida">LinkedIn</a>
            <a href="mailto:daniel.almeida@wyngrove.com">Email</a>
        </footer>
    </div>
</body>
</html>

<style is:global>
    :root {
        --text-primary: #1a1a1a;
        --text-secondary: #4a4a4a;
        --text-tertiary: #737373;
        --accent: #8b5a3c;
        --background: #fafaf8;
        --border: #e5e5e0;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Crimson Pro', serif;
        font-size: 19px;
        line-height: 1.7;
        color: var(--text-primary);
        background: var(--background);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .container {
        max-width: 680px;
        margin: 0 auto;
        padding: 80px 24px 120px;
    }

    header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 80px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
    }

    .name {
        font-family: 'Work Sans', sans-serif;
        font-size: 16px;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .name:hover {
        color: var(--accent);
    }

    nav {
        font-family: 'Work Sans', sans-serif;
        font-size: 14px;
        letter-spacing: 0.02em;
    }

    nav a {
        color: var(--text-secondary);
        text-decoration: none;
        margin-right: 28px;
        transition: color 0.2s ease;
    }

    nav a:last-child {
        margin-right: 0;
    }

    nav a:hover {
        color: var(--text-primary);
    }

    h1 {
        font-size: 32px;
        font-weight: 600;
        line-height: 1.1;
        margin-bottom: 48px;
        letter-spacing: -0.01em;
    }

    h2 {
        font-family: 'Work Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-tertiary);
        margin-top: 64px;
        margin-bottom: 24px;
    }

    p {
        margin-bottom: 24px;
        max-width: 620px;
    }

    section {
        margin-bottom: 72px;
    }

    .divider {
        height: 1px;
        background: var(--border);
        margin: 72px 0;
    }

    strong {
        font-weight: 600;
        color: var(--text-primary);
    }

    footer {
        margin-top: 96px;
        padding-top: 32px;
        border-top: 1px solid var(--border);
        font-family: 'Work Sans', sans-serif;
        font-size: 14px;
        color: var(--text-tertiary);
    }

    footer a {
        color: var(--text-secondary);
        text-decoration: none;
        margin-right: 24px;
        transition: color 0.2s ease;
    }

    footer a:hover {
        color: var(--text-primary);
    }

    @media (max-width: 768px) {
        .container {
            padding: 48px 20px 80px;
        }

        header {
            flex-direction: column;
            align-items: flex-start;
            gap: 24px;
            margin-bottom: 60px;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 36px;
        }

        section {
            margin-bottom: 56px;
        }
    }
</style>