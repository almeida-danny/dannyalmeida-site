---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const essays = await getCollection('essays');
const sortedEssays = essays.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Perspective">
    <h1>Perspective</h1>
    <p style="font-size: 19px; color: var(--text-secondary); margin-bottom: 72px;">Essays on pricing and commercial execution.</p>

    <div class="essay-list">
        {sortedEssays.map((essay) => (
            <article class="essay">
                <div class="essay-meta">{essay.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</div>
                <h2 class="essay-title">
                    <a href={`/essays/${essay.slug}`}>{essay.data.title}</a>
                </h2>
                <p class="essay-description">{essay.data.description}</p>
            </article>
        ))}
    </div>

    <style>
        .essay-list {
            display: flex;
            flex-direction: column;
            gap: 56px;
        }

        .essay {
            padding-bottom: 56px;
            border-bottom: 1px solid var(--border);
        }

        .essay:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .essay-meta {
            font-family: 'Work Sans', sans-serif;
            font-size: 13px;
            letter-spacing: 0.02em;
            color: var(--text-tertiary);
            margin-bottom: 12px;
        }

        .essay-title {
            font-size: 24px;
            font-weight: 600;
            line-height: 1.3;
            margin-bottom: 16px;
            letter-spacing: -0.01em;
            text-transform: none;
            margin-top: 0;
        }

        .essay-title a {
            color: var(--text-primary);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .essay-title a:hover {
            color: var(--accent);
        }

        .essay-description {
            font-size: 18px;
            line-height: 1.6;
            color: var(--text-secondary);
            max-width: 620px;
        }
    </style>
</BaseLayout>